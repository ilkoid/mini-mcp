# Compiled binary (installed to ~/bin/mcp-pg-readonly via the wrapper)
/mcp-pg-readonly
*.exe

# Local env / secrets (wrapper sources ~/.config/mcp-pg-readonly/env)
.env
.env.*

# Anonymization rules — the filled-in copy contains the keywords being hidden
anonymize.yaml

# Editor / OS noise
.DS_Store
*.swp

# Local ZCode session artifacts (plans, etc.)
.zcode/

# Throwaway PLM survey runner (reports/2026-09-26_plm-1c-survey.md §Готовая инфраструктура)
/plm-survey/


# Binary survey deliverables (the .md reports stay in git)
reports/*.xlsx
